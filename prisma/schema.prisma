

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}
model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customers  Customer[]

  @@map("users")
}

model Customer{
  id Int @id @default(autoincrement()) 
  name String 
  email String @unique
  status Boolean 
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

userId Int
user User @relation(fields: [userId], references: [id])

@@map("customers")
}